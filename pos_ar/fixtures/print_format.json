  "html": "<style>\n@media print {\n    @page {\n        size: A4 portrait;\n        margin: 6mm 6mm 8mm 6mm;\n    }\n}\n.print-page {\n    font-family: Arial, sans-serif;\n    color: #000000;\n    padding: 0;\n}\n.print-page-footer {\n    text-align: center;\n    font-size: 10px;\n    font-weight: bold;\n    margin-top: 4px;\n    color: #000000;\n}\n.print-page table {\n    width: auto;\n    max-width: 100%;\n    border-collapse: collapse;\n    border: 1px solid #000000;\n    line-height: 1.05;\n}\n.print-page th,\n.print-page td {\n    border: 1px solid #000000;\n    padding: 0 3px;\n    font-size: 11px;\n    color: #000000;\n    white-space: nowrap;\n}\n.print-page th {\n    background-color: #f2f2f2;\n    font-weight: bold;\n    text-align: left;\n}\n.print-page td.qty {\n    text-align: center;\n    font-weight: bold;\n}\n.print-page td.code {\n    font-weight: bold;\n}\n</style>\n\n{%- set rows_per_page = 30 -%}\n{%- set n = doc.items|length -%}\n{%- if n == 0 -%}\n    {%- set total_pages = 1 -%}\n{%- else -%}\n    {%- set total_pages = ((n - 1) // rows_per_page) + 1 -%}\n{%- endif -%}\n\n{% for page_num in range(total_pages) %}\n{%- set start = page_num * rows_per_page -%}\n{%- set end = start + rows_per_page -%}\n<div class=\"print-page\"{% if not loop.last %} style=\"page-break-after: always;\"{% endif %}>\n    <h3 style=\"margin: 0 0 3px 0; font-size: 12px; font-weight: bold; color: #000000;\">\n        {{ doc.doctype }} : {{ doc.name }}\n    </h3>\n\n    <table>\n        <thead>\n            <tr>\n                <th>Code de l'Article (Articles)</th>\n                <th style=\"width: 90px; text-align: center;\">Quantité</th>\n                <th style=\"width: 90px;\">Reçu</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items[start:end] %}\n            <tr style=\"page-break-inside: avoid;\">\n                <td class=\"code\">{{ item.item_code }}</td>\n                <td class=\"qty\">{{ item.qty }}</td>\n                <td></td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"print-page-footer\">\n        Page {{ page_num + 1 }} / {{ total_pages }}\n    </div>\n</div>\n{% endfor %}\n",

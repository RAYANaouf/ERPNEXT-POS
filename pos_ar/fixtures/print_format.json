  "html": "<style>\r\n    body {\r\n        font-family: monospace;\r\n        width: 58mm;\r\n        font-size: 11px;\r\n        margin: 0;\r\n        padding: 0;\r\n    }\r\n\r\n    .center {\r\n        text-align: center;\r\n    }\r\n\r\n    .title {\r\n        font-size: 14px;\r\n        font-weight: bold;\r\n        margin-top: 5px;\r\n    }\r\n\r\n    .status {\r\n        font-size: 12px;\r\n        font-weight: bold;\r\n        margin: 3px 0;\r\n    }\r\n\r\n    .line {\r\n        border-top: 1px dashed #000;\r\n        margin: 5px 0;\r\n    }\r\n\r\n    table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    td {\r\n        padding: 2px 0;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .info b {\r\n        display: inline-block;\r\n        width: 75px;\r\n    }\r\n\r\n    img {\r\n        display: block;\r\n        margin: auto;\r\n        max-width: 120px;\r\n    }\r\n</style>\r\n\r\n<div class=\"center\">\r\n    <img src=\"/files/optilens_logo.jpg\">\r\n</div>\r\n\r\n<div class=\"center title\">\r\n    MOUVEMENT DE STOCK\r\n</div>\r\n\r\n<div class=\"center status\">\r\n    {{doc.workflow_state}}\r\n</div>\r\n\r\n<div class=\"line\"></div>\r\n\r\n<div class=\"info\">\r\n    <b>N° :</b> {{ doc.name }}<br>\r\n    <b>Date :</b> {{ doc.posting_date }}<br>\r\n    <b>Type :</b> {{ doc.stock_entry_type }}<br>\r\n    <b>Src :</b> {{ doc.from_warehouse or \"-\" }}<br>\r\n    <b>Dst :</b> {{ doc.to_warehouse or \"-\" }}<br>\r\n</div>\r\n\r\n<div class=\"line\"></div>\r\n\r\n<table>\r\n    <tr>\r\n        <td><b>Carton</b></td>\r\n    </tr>\r\n\r\n    {% for row in doc.custom_carton_table %}\r\n    <tr>\r\n        <td>{{ row.carton }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n</table>\r\n\r\n<div class=\"line\"></div>\r\n\r\n<div class=\"center\">\r\n    Merci \r\n</div>",
